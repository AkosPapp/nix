# GENERATED BY THE PASEO MACHINE INSTALLER - MANAGED FILE, DO NOT EDIT
#
# Rendered from packages/paseo/machine/templates/paseo.service.in by all three
# provisioning paths, so they cannot drift:
#   * the rootless installer        -> ~/.config/systemd/user/paseo.service
#   * modules/services/paseo-machine.nix (NixOS user service)
#   * modules/home/paseo-machine.nix     (home-manager systemd.user.services)
# A hand-edit here shows up as a diff against the template on the next run and is
# then replaced (a backup is kept next to it). Change the template instead.
[Unit]
Description=Paseo daemon (%%HARNESS%%)
Documentation=https://paseo.sh/docs
# network-online.target in BOTH directions. After= alone does not pull the target in;
# Wants= alone gives no ordering, so the first relay dial can still race DNS and the
# daemon comes up "connected: false" until the next reconnect.
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
# `daemon run` is the foreground subcommand. `daemon start` double-forks, which makes
# systemd believe the unit exited straight away and restart-loop the daemon.
ExecStart=%%BIN%%
WorkingDirectory=%%HOME%%
Environment=NODE_ENV=production
# Deliberately NO NODE_OPTIONS here: the daemon strips it for agent subprocesses and
# that is part of what breaks terminal spawn / shell integration.
Environment=PASEO_HOME=%%PASEO_HOME%%
Environment=PASEO_LISTEN=%%LISTEN%%
Environment=PASEO_WEB_UI_ENABLED=true
Environment=PASEO_RELAY_ENABLED=true
Environment=PASEO_RELAY_ENDPOINT=%%RELAY_ENDPOINT%%
Environment=PASEO_RELAY_PUBLIC_ENDPOINT=%%RELAY_ENDPOINT%%
Environment=PASEO_RELAY_USE_TLS=%%RELAY_TLS%%
Environment=PASEO_RELAY_PUBLIC_USE_TLS=%%RELAY_TLS%%
# Secrets live in 0600 files you own, outside the Nix store, and are NOT in argv
# (argv is world-readable through ps and lands in journald). `systemctl show` does
# not print EnvironmentFile contents. The trailing - means "optional": a missing
# model key must not stop the daemon from starting.
EnvironmentFile=%%HOME%%/.config/paseo/credentials/daemon_password
EnvironmentFile=-%%HOME%%/.config/paseo/credentials/model_api_key
# Curated for THIS platform (see psi_compute_service_path / services.paseo-machine.pathExtra).
# bin/paseo starts with `#!/usr/bin/env -S node ...`, so a PATH without node fails the
# unit with status 127/203/EXEC - which looks like "the installer killed my terminals".
Environment=PATH=%%PATH%%

# Graceful stop. SIGTERM first, a real fuse, then cgroup kill. The `-` on ExecStop
# means its failure cannot abort the stop sequence. Without TimeoutStopSec a hung
# daemon blocks `systemctl --user stop` indefinitely, which is how an install ends up
# resorting to SIGKILL while npm is mid-write - the exact thing that hollowed the
# npm prefix and deleted the shell-integration files under the running daemon.
KillMode=control-group
KillSignal=SIGTERM
ExecStop=-%%BIN%% daemon stop --home %%PASEO_HOME%%
TimeoutStartSec=90
TimeoutStopSec=45
Restart=on-failure
RestartSec=5
# Backoff: a broken prefix must not trip the start-limit, which leaves the machine
# dead until somebody runs `systemctl --user reset-failed`.
StartLimitIntervalSec=300
StartLimitBurst=5

# Rootless, but not so hardened that the daemon cannot do its job: it must write
# ~/.paseo and ~/.pi/agent and spawn arbitrary build commands. PrivateTmp/
# ProtectSystem=strict would recreate the "unit is green, terminals are dead" state.
NoNewPrivileges=true
UMask=0077

[Install]
WantedBy=default.target
