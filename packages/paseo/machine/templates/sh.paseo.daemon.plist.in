<?xml version="1.0" encoding="UTF-8"?>
<!-- GENERATED BY THE PASEO MACHINE INSTALLER - MANAGED FILE, DO NOT EDIT
     Same intent as templates/paseo.service.in; see that file for the reasoning.
     Load with:  launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/sh.paseo.daemon.plist

     The program is %%BIN%%-launch, NOT %%BIN%% directly, because launchd has no
     EnvironmentFile= equivalent: the launcher is what sources the 0600 credential files
     and then execs the daemon. That keeps PASEO_PASSWORD out of this plist (launchd
     plists are world-readable by design) and out of argv.

     This header is an XML comment and sits *below* the <?xml?> prolog on purpose: `#`
     comments are not XML, and a plist that starts with them is not a property list at
     all - launchctl refuses to bootstrap it ("Could not read property list: ...") before
     anything in ProgramArguments ever runs. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>sh.paseo.daemon</string>
  <key>ProgramArguments</key>
  <array>
    <string>%%LAUNCHER%%</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key>
  <dict>
    <!-- Restart on crash, not on a clean exit, or `launchctl bootout` during an
         install would fight the installer. -->
    <key>SuccessfulExit</key><false/>
    <key>Crashed</key><true/>
  </dict>
  <key>ThrottleInterval</key><integer>5</integer>
  <!-- launchd reads neither /etc/environment nor your shell profile, and bin/paseo
       starts with `#!/usr/bin/env -S node`, so PATH must be explicit and contain node. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>%%PATH%%</string>
    <key>PASEO_HOME</key><string>%%PASEO_HOME%%</string>
    <key>PASEO_LISTEN</key><string>%%LISTEN%%</string>
    <key>PASEO_RELAY_ENABLED</key><string>true</string>
    <key>PASEO_RELAY_ENDPOINT</key><string>%%RELAY_ENDPOINT%%</string>
    <key>PASEO_RELAY_PUBLIC_ENDPOINT</key><string>%%RELAY_ENDPOINT%%</string>
    <key>PASEO_RELAY_USE_TLS</key><string>%%RELAY_TLS%%</string>
    <key>PASEO_RELAY_PUBLIC_USE_TLS</key><string>%%RELAY_TLS%%</string>
    <key>PASEO_WEB_UI_ENABLED</key><string>true</string>
    <key>NODE_ENV</key><string>production</string>
  </dict>
  <key>WorkingDirectory</key><string>%%HOME%%</string>
  <key>StandardOutPath</key><string>%%PASEO_HOME%%/daemon.out</string>
  <key>StandardErrorPath</key><string>%%PASEO_HOME%%/daemon.err</string>
</dict>
</plist>
